{{ ansible_managed | comment }}

server:
    prefetch: yes
    {%+ if unbound_conf_serve_stale -%}
    # enable stale data serving
    serve-expired: yes
    # four hours
    serve-expired-ttl: 14400
    # 1.8 s as timeout before fallback to stale data
    serve-expired-client-timeout: 1800
    {%- endif +%}
